# Database (PostgreSQL)
DB_HOST=your-db-host.vercel.app
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=nova_commerce
DB_SSL=true

# JWT (Generate strong secrets for production!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# App
APP_PORT=3000
APP_ENV=production

# CORS (comma-separated origins)
CORS_ORIGINS=https://your-app.vercel.app,https://nova-commerce.vercel.app

# SMS Provider
SMS_PROVIDER=twilio
SMS_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_TWILIO_AUTH_TOKEN=your_auth_token
SMS_TWILIO_FROM_NUMBER=+1234567890

# S3 / Image Storage
S3_BUCKET=nova-commerce-assets
S3_REGION=eu-west-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
