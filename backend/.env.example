# ===========================================
# NOVA Commerce - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nova_commerce
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nova_commerce

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your-super-secret-key-at-least-256-bits-long
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# SMS Provider (Twilio)
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===========================================
# Email (SMTP)
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@novacommerce.io

# ===========================================
# File Storage
# ===========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ===========================================
# Rate Limiting
# ===========================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug

# ===========================================
# Redis (for caching & queues)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
